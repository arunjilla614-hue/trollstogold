# ===========================================================
# TROLL TO GOLD — ENVIRONMENT CONFIGURATION
# ===========================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.
# ===========================================================

# -----------------------------------------------------------
# FEATHERLESS AI — Primary LLM Provider
# -----------------------------------------------------------
# Get your API key at: https://featherless.ai
FEATHERLESS_API_KEY=

# The model ID to use for inference (must be available on Featherless)
# Example: meta-llama/Meta-Llama-3.1-8B-Instruct
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# -----------------------------------------------------------
# YOUTUBE DATA API v3
# -----------------------------------------------------------
# Enable the YouTube Data API v3 in Google Cloud Console
# and create an API key: https://console.cloud.google.com/
YOUTUBE_API_KEY=

# -----------------------------------------------------------
# SERVER
# -----------------------------------------------------------
PORT=5000
NODE_ENV=development

# -----------------------------------------------------------
# CORS — Frontend Origin
# -----------------------------------------------------------
# The Vite dev server runs on port 5173 by default
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------
# DEMO MODE
# -----------------------------------------------------------
# Set to true to run without real API credentials.
# Returns mock YouTube comments and AI responses with the
# same schema as live mode. Useful for frontend development.
DEMO_MODE=false
